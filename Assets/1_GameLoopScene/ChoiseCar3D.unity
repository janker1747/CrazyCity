  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FF9F1C><size=120%><b>T \u2014 \u0433\u0440\u0443\u0437\u044B \u0441
    \u0442\u0430\u0439\u043C\u0435\u0440\u043E\u043C</b></size></color>\n\n\u044D\u0442\u0438
    \u0433\u0440\u0443\u0437\u044B \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0434\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\n\n\u0422\u0430\u0439\u043C\u0435\u0440
    <color=#FFD166><b>\u043E\u0431\u0449\u0438\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0445
    \u0433\u0440\u0443\u0437\u043E\u0432 \u044D\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430</b></color>.\n\n\u043A\u043E\u0433\u0434\u0430
    \u0442\u044B \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u043F\u0435\u0440\u0432\u044B\u0439
    \u0442\u0430\u043A\u043E\u0439 \u0433\u0440\u0443\u0437, \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442\u0441\u0447\u0451\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\n\n\u0435\u0441\u043B\u0438
    \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F,
    <color=#FF6B6B><b>\u0432\u0441\u0435 \u0433\u0440\u0443\u0437\u044B \u0441 \u0442\u0430\u0439\u043C\u0435\u0440\u043E\u043C
    \u0432 \u0431\u0430\u0433\u0430\u0436\u043D\u0438\u043A\u0435 \u0441\u0433\u043E\u0440\u044F\u0442</b></color>,
    \u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0433\u0440\u0443\u0437\u043E\u0432
    \u0432 \u043A\u043E\u043C\u0431\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u0441\u044F."
