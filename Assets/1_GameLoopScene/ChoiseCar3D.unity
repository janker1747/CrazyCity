  m_text: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u0430\u0448\u0438\u043D\u044B
    \u0441\u0432\u043E\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:\n\n<color=#5EC8FF><b>\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C</b></color>
    \u2014 \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u044B\u0441\u0442\u0440\u043E
    \u043E\u043D\u0430 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442\u0441\u044F
    \u0438 \u0435\u0434\u0435\u0442.\n\n<color=#6EEB83><b>\u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435</b></color>
    \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0440\u043E\u043D\u0430
    \u043C\u0430\u0448\u0438\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442\u044C.\n\n<color=#FFD166><b>\u043A\u043E\u043C\u0431\u043E-\u0431\u043E\u043D\u0443\u0441</b></color>
    \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043E\u0447\u043A\u043E\u0432 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C
    \u0437\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u043A\u043E\u043C\u0431\u043E."
