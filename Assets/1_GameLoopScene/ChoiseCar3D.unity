    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0410 \u0432 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C \u2014
    \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u0442\u0430\u0439\u0441\u044F
    \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0439 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435.\n\n\u0412\u0441\u043F\u043E\u043C\u043D\u0438
    \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u0442\u044B \u043A\u0430\u0442\u0430\u043B \u043C\u0430\u0448\u0438\u043D\u043A\u0443
    \u043F\u043E \u043A\u043E\u0432\u0440\u0443 \u0441 \u0434\u043E\u0440\u043E\u0433\u0430\u043C\u0438,
    \u0430 \u0432 \u0442\u0432\u043E\u0451\u043C \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
    \u043E\u043D\u0430 \u043C\u043E\u0433\u043B\u0430 \u0435\u0437\u0434\u0438\u0442\u044C
    \u0433\u0434\u0435 \u0443\u0433\u043E\u0434\u043D\u043E:\n\n<color=#FFD166><b>\u043F\u043E
    \u0434\u043E\u0440\u043E\u0433\u0430\u043C, \u0441\u0442\u0435\u043D\u0430\u043C
    \u0438 \u0434\u0430\u0436\u0435 \u043F\u043E\u0442\u043E\u043B\u043A\u0443.</b></color>\n\n\u0437\u0434\u0435\u0441\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u0442\u0435 \u0436\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430.\n\n<size=120%><b>\u043D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!</b></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ebbd07238528c5b46b9024502455b148, type: 2}
