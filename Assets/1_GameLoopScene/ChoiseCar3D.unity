  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u044D\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u0433\u0440\u044B
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0447\u0430\u0441\u0442\u044C
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430. \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
    \u0430\u0443\u0434\u0438\u043E\u0434\u0438\u0437\u0430\u0439\u043D \u0438 \u043B\u0438\u0434\u0435\u0440\u0431\u043E\u0440\u0434\u0430\n\n\u0415\u0451
    \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430
    \u2014 \u043F\u043E\u043D\u044F\u0442\u044C:\n\n<color=#5EC8FF>\u2022 \u0447\u0435\u0433\u043E
    \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u044E;</color>\n<color=#5EC8FF>\u2022
    \u043A\u0430\u043A\u0438\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E;</color>\n<color=#5EC8FF>\u2022
    \u0447\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0438\u043B\u0438 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C.</color>\n\n\u043D\u0435
    \u0431\u043E\u0439\u0441\u044F \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043D\u0430 \u043C\u043E\u043C\u0435\u043D\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u0441\u043A\u0443\u0447\u043D\u044B\u043C\u0438,
    \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u044B\u043C\u0438 \u0438\u043B\u0438
    \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u043C\u0438."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ebbd07238528c5b46b9024502455b148, type: 2}
